# Postgres de Chatwoot (independiente del de storage/)
POSTGRES_USER=chatwoot
POSTGRES_PASSWORD=
POSTGRES_DB=chatwoot

# Rails secret key -> openssl rand -hex 64
SECRET_KEY_BASE=

# URL pública de Chatwoot (según el dominio configurado en el tunnel)
FRONTEND_URL=https://chatwoot.goblin-sw.com

# Email remitente (debe pertenecer a un dominio verificado en Resend)
MAILER_SENDER_EMAIL=

# API key de Resend -> resend.com > Dashboard > API Keys
SMTP_PASSWORD=
