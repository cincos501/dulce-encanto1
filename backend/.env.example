APP_NAME="Dulce Encanto"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de Datos MySQL Principal
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dulce_encanto_bd
DB_USERNAME=root
DB_PASSWORD=

# Manejo de Sesiones y Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Colas y Memoria Redis para IA y Borradores
QUEUE_CONNECTION=database
CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=1
REDIS_CACHE_DB=2

# Sanctum y CORS Frontend
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Almacenamiento en Supabase
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_BUCKET=products
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Configuración de Correo Electrónico (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="Dulce Encanto"

# Chatwoot & Meta WhatsApp Cloud API Gateway
CHATWOOT_URL=http://localhost:3001
CHATWOOT_API_TOKEN=your_chatwoot_api_token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_WEBHOOK_SECRET=your_webhook_secret
META_ACCESS_TOKEN=your_meta_access_token
CHATWOOT_SEND_RESPONSES=true

# Teléfonos de Notificación Interna para Vendedores / Admins
CHATWOOT_ADMIN_PHONE=+59100000000
CHATWOOT_REPOSTERO_PHONE=+59100000000

# Proveedores de Inteligencia Artificial (gemini / groq)
AI_PROVIDER=gemini

# Google Gemini API
OPENAI_API_KEY=your_gemini_api_key
OPENAI_MODEL=gemini-3.5-flash-lite
OPENAI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
OPENAI_TEMPERATURE=0.2
OPENAI_TOP_P=0.9

# Groq API (Inferencia Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_TOP_P=0.9

# IA Multimedia: transcripción de audios y visión de imágenes de WhatsApp
AI_TRANSCRIPTION_DRIVER=gemini        # gemini | openai_whisper | (vacío = desactivado)
AI_TRANSCRIPTION_LANGUAGE=es
AI_VISION_DRIVER=gemini               # gemini | (vacío)
AI_VISION_ENABLED=true
GEMINI_MEDIA_MODEL=gemini-2.0-flash
# GEMINI_MEDIA_API_KEY=               # opcional; por defecto usa OPENAI_API_KEY (key de Gemini)
# WHISPER_API_KEY=                    # solo si AI_TRANSCRIPTION_DRIVER=openai_whisper
# WHISPER_MODEL=whisper-1
# WHATSAPP_PHONE_NUMBER_ID=           # opcional; habilita el envío de ubicación nativa por Meta Cloud API

# Ubicación de la pastelería (asistente "Encantito")
BUSINESS_NAME="Dulce Encanto"
BUSINESS_CITY="Tarija, Bolivia"
BUSINESS_ADDRESS="Avenida Circunvalación, Barrio Carlos Wagner, Av. Los Crespones, Tarija, Bolivia"
BUSINESS_LATITUDE=-21.50631914541871
BUSINESS_LONGITUDE=-64.75171651298785
BUSINESS_MAPS_URL="https://maps.google.com/?q=-21.50631914541871,-64.75171651298785"
BUSINESS_LOCATION_REFERENCE="A pocos metros de la Av. Los Crespones."
BUSINESS_PHONE="+591 70012345"

# Pasarela de Pagos QR Banco Económico (Baneco)
BANECO_BASE_URL=https://apimkt.baneco.com.bo/ApiGateway/
BANECO_USERNAME=your_baneco_username
BANECO_PASSWORD=your_baneco_password
BANECO_AES_KEY=your_32_byte_aes_key_here
BANECO_ACCOUNT=your_credit_account_number
BANECO_TIMEOUT=30
BANECO_VERIFY_SSL=true
BANECO_NOTIFICATION_ENABLED=true
BANECO_QR_EXPIRATION_DAYS=1
